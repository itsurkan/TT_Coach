<?xml version="1.0" encoding="utf-8"?>
<!-- One page of RepCarouselView's RecyclerView: a single rep's start/end skeleton pair,
     side by side, mirroring cardStrokeSnapshot's original single-pair layout
     (fragment_session_review.xml) and sheet_feedback_explanation.xml's pose-snapshot row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <com.ttcoachai.views.PoseSnapshotView
            android:id="@+id/pose_snapshot_start_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="170dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/feedback_snapshot_label_start"
            android:textAppearance="@style/TextAppearance.TTC.Eyebrow"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <com.ttcoachai.views.PoseSnapshotView
            android:id="@+id/pose_snapshot_end_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="170dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/feedback_snapshot_label_end"
            android:textAppearance="@style/TextAppearance.TTC.Eyebrow"/>
    </LinearLayout>
</LinearLayout>
