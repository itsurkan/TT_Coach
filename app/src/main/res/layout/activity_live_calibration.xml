<?xml version="1.0" encoding="utf-8"?>
<!--
    RTMPose calibration screen (shippable, NOT debug-gated — see LiveCalibrationActivity).
    Camera preview + live skeleton overlay run continuously in cameraContainer (top region) so
    the player can confirm their whole body — including knees/ankles — is tracked before and
    during recording. The panel below toggles between four states (one visible at a time):
    instructions -> recording -> processing -> result. Mirrors the shape of
    calibration/CalibrationActivity's onboarding -> capture -> review flow, but as a single
    Activity with visibility-toggled groups instead of a fragment host.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/live_calibration_title"
        app:titleTextColor="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/panelScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="200dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.ttcoachai.pose.Coco17OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/panelScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/cameraContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            style="@style/TTC.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Step 1: instructions -->
                <LinearLayout
                    android:id="@+id/groupInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvInstructionsHeadline"
                        style="@style/TTC.SectionHeader.Gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_calibration_headline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/live_calibration_instructions_body"
                        android:textAppearance="@style/TextAppearance.TTC.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/live_calibration_skeleton_hint"
                        android:textAppearance="@style/TextAppearance.TTC.Body.Secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartRecording"
                        style="@style/TTC.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/live_calibration_start_button" />

                </LinearLayout>

                <!-- Step 2: recording -->
                <LinearLayout
                    android:id="@+id/groupRecording"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvRecordingStatus"
                        style="@style/TTC.SectionHeader.Gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_calibration_recording_headline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/live_calibration_recording_body"
                        android:textAppearance="@style/TextAppearance.TTC.Body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelRecording"
                            style="@style/TTC.Button.Ghost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/live_calibration_cancel_button" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFinishRecording"
                            style="@style/TTC.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_calibration_finish_button" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 3: processing -->
                <LinearLayout
                    android:id="@+id/groupProcessing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/live_calibration_processing"
                        android:textAppearance="@style/TextAppearance.TTC.Body" />

                </LinearLayout>

                <!-- Step 4: result (success or failure) -->
                <LinearLayout
                    android:id="@+id/groupResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResultTitle"
                        style="@style/TTC.SectionHeader.Gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvResultBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.TTC.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResultPrimary"
                        style="@style/TTC.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
